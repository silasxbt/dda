{
  "name": "dda-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "probe": "tsx src/cli.ts probe",
    "collect": "tsx src/cli.ts collect",
    "report": "tsx src/cli.ts report",
    "replay": "tsx src/cli.ts replay",
    "check": "tsc --noEmit",
    "test:serve": "tsx src/test-server.ts",
    "test:token": "node scripts/compile-test-token.mjs",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/static": "10.1.6",
    "@raydium-io/raydium-sdk-v2": "0.2.74-alpha",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "bn.js": "5.2.5",
    "decimal.js": "10.6.0",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.57.7"
  },
  "devDependencies": {
    "@types/bn.js": "5.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "solc": "0.8.30",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
